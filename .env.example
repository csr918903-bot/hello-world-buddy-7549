# Copie este arquivo como ".env" e preencha com as chaves do seu projeto Supabase
# (Project Settings > API). As mesmas duas linhas vão nas Environment Variables da Vercel.
# Sem elas o site funciona, mas os posts ficam salvos só no navegador de cada pessoa.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
